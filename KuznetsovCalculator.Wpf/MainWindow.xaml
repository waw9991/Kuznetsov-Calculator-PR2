<Window x:Class="KuznetsovCalculator.Wpf.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Калькулятор — Кузнецов А. А. | ИПс-21"
 Width="900" Height="720" MinWidth="800" MinHeight="690"
 Background="#F1F4F7" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
 PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18">
   <TextBlock Text="Калькулятор" FontSize="30" FontWeight="SemiBold" Foreground="#1F3444"/>
   <TextBlock Text="Кузнецов Андрей Андреевич · ИПс-21 · Практическая работа № 2" Foreground="#566774" Margin="0,6,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="#E0EAF0" Padding="18" CornerRadius="8">
     <StackPanel>
      <TextBlock Text="ВЫРАЖЕНИЕ" Foreground="#4D6373" FontSize="11" Margin="0,0,0,6"/>
      <TextBox x:Name="ExpressionBox" Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
       MaxLength="256" FontSize="24" Padding="6" BorderThickness="0" Background="White"
       AutomationProperties.Name="Выражение"/>
      <TextBlock Text="{Binding Result}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Right"
       Foreground="#203C50" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Результат"/>
     </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Text="{Binding Error}" Foreground="#AB3434" TextWrapping="Wrap" MinHeight="42" Margin="4,8"/>
    <Grid Grid.Row="2">
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <UniformGrid Columns="4" Rows="5">
     <Button Content="C" Click="Clear_Click"/><Button Content="⌫" Click="Backspace_Click"/>
     <Button Content="(" Click="Input_Click"/><Button Content=")" Click="Input_Click"/>
     <Button Content="7" Click="Input_Click"/><Button Content="8" Click="Input_Click"/><Button Content="9" Click="Input_Click"/>
     <Button Content="/" Click="Input_Click" Style="{StaticResource Operator}"/>
     <Button Content="4" Click="Input_Click"/><Button Content="5" Click="Input_Click"/><Button Content="6" Click="Input_Click"/>
     <Button Content="*" Click="Input_Click" Style="{StaticResource Operator}"/>
     <Button Content="1" Click="Input_Click"/><Button Content="2" Click="Input_Click"/><Button Content="3" Click="Input_Click"/>
     <Button Content="-" Click="Input_Click" Style="{StaticResource Operator}"/>
     <Button Content="0" Click="Input_Click"/><Button Content="," Click="Input_Click"/>
     <Button Content="^" Click="Input_Click" Style="{StaticResource Operator}"/>
     <Button Content="+" Click="Input_Click" Style="{StaticResource Operator}"/>
    </UniformGrid>
    <Button Grid.Row="1" Content="=" Click="Evaluate_Click" Background="#254B67" Foreground="White"/>
    </Grid>
   </Grid>
   <Border Grid.Column="2" Background="White" Padding="16" CornerRadius="8">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="История вычислений" FontWeight="SemiBold" FontSize="18" Foreground="#1F3444"/>
      <TextBlock Text="Последние 20 результатов" Foreground="#667783" Margin="0,6,0,12"/></StackPanel>
     <ListBox x:Name="HistoryList" Grid.Row="1" ItemsSource="{Binding History}" BorderThickness="0"
       SelectionChanged="History_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="История">
      <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="17" Margin="0,8"/></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Grid.Row="2" Content="Очистить историю" Click="ClearHistory_Click" FontSize="14"/>
    </Grid>
   </Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="Enter — вычислить · Esc — очистить · Запятая или точка — дробная часть"
   Foreground="#526774" Margin="0,16,0,0"/>
 </Grid>
</Window>
